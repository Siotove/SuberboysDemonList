{
  "$schema": "https://schema.cloudflare.com/wrangler/config-schema.json",
  "name": "suberboysdemonlist",
  "main": "./worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "suberboys-accounts",
      "database_id": "9b7197a0-0966-4795-b0b8-c262f3ae5dcd"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
